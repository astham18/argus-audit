# Copy to .env and fill in. .env is git-ignored; never commit a key.
# argus reads .env from the repository root, then the process environment.

# OpenRouter key for the judge (argus/judge.py). Bulk judging uses anthropic/claude-haiku-5.5,
# adjudication anthropic/claude-opus-5.5. Leave empty to run only the parts that need no judge.
OPENROUTER_API_KEY=

# Modal (GPU runs on one A10G). Either run `modal token new` once (writes ~/.modal.toml),
# or set the token pair here.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# App and volume names used by argus/modal/*.py (the Dolos hunt used these).
ARGUS_MODAL_APP=dolos-hunt
ARGUS_MODAL_VOLUME=dolos-hunt-models

# Optional settings
# ARGUS_ROOT=            # repository root if you run scripts from outside it
# ARGUS_BUDGET=          # budget caps file (default dolos/budget/budget_caps.json); a new hunt uses its own
# HUNT_BACKEND=local     # default backend for argus.modal.batch_generate: modal | modal_cpu | local
# ARGUS_SPRINT_REPO=     # sprint starter repo clone; only the data-building scripts read it
# HF_TOKEN=              # only if you audit a gated Hugging Face model (Dolos and Qwen are public)
